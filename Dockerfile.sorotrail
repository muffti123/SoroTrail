FROM golang:1.27-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /sorotrail ./cmd/sorotrail

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=build /sorotrail /sorotrail
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 CMD ["/sorotrail", "healthcheck", "--endpoint", "/readyz", "--timeout", "3s"]
ENTRYPOINT ["/sorotrail"]
